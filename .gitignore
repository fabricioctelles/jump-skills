# --------------------------------------------
.env
.env.*
*.env
.env.local
.env.development
.env.production
.env.*.local

# API keys and tokens
*.api_key
*apikey*
*.secret
token.json
tokens.json
*_token.json
client_secret*.json
oauth*.json
credentials.json

# AWS credentials
.aws/
credentials
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# SOPS decrypted files
*.decrypted
*.decrypted.*
*.plaintext
*.unencrypted

# --------------------------------------------
# SSH & GPG Keys
# --------------------------------------------
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
id_dsa
id_dsa.pub
*.ppk
known_hosts
authorized_keys
*.gpg
*.asc
secring.*

# --------------------------------------------
