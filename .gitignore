# Package Manager & Dependencies
# --------------------------------------------
node_modules/
__pycache__/
*.py[cod]
*$py.class
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.tox/
.nox/
.eggs/
